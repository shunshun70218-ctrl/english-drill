  "lines": [
    { "role": "A", "en": "Hi there. Table for two?", "zh": "嗨，兩位嗎？" },
    { "role": "B", "en": "Yes, please. Do we need a reservation?", "zh": "是的。需要訂位嗎？" },
    { "role": "A", "en": "Not tonight. Right this way.", "zh": "今晚不用。這邊請。" },
    { "role": "A", "en": "Here are your menus. Anything to drink?", "zh": "這是菜單。要喝點什麼嗎？" },
    { "role": "B", "en": "Just water for now, thanks.", "zh": "先給水就好，謝謝。" },
    { "role": "A", "en": "Are you ready to order?", "zh": "可以點餐了嗎？" },
    { "role": "B", "en": "What would you recommend?", "zh": "你推薦什麼？" },
    { "role": "A", "en": "The grilled salmon is very popular.", "zh": "烤鮭魚很受歡迎。" },
    { "role": "B", "en": "I'll have that, please.", "zh": "那我要那個。" },
    { "role": "A", "en": "Any sides with that?", "zh": "要配什麼嗎？" },
    { "role": "B", "en": "A side salad, please. No onions.", "zh": "一份沙拉，不要洋蔥。" },
    { "role": "A", "en": "Of course. Anything else?", "zh": "沒問題。還需要別的嗎？" },
