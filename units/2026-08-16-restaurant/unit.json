    { "role": "B", "en": "Excuse me, could we get the check?", "zh": "不好意思，可以買單嗎？" },
    { "role": "A", "en": "Sure. All together or separate?", "zh": "好的。一起付還是分開付？" },
    { "role": "B", "en": "All together. Can I pay by card?", "zh": "一起付。可以刷卡嗎？" },
    { "role": "A", "en": "Absolutely. I'll be right back.", "zh": "當然可以，我馬上回來。" },
