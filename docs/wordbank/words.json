{"count": 98, "words": [{"term": "agenda", "syllables": ["a", "gen", "da"], "stress": 1, "ipa": "əˈdʒɛn.də", "pos": "n.", "zh": "議程", "theme": "辦公室與行政", "example_en": "Please review the agenda before the meeting.", "example_zh": "請在會議前看過議程。", "audio": "audio/office-01-w.m4a", "audio_ms": 598, "example_audio": "audio/office-01-e.m4a", "example_ms": 2204}, {"term": "attachment", "syllables": ["at", "tach", "ment"], "stress": 1, "ipa": "əˈtætʃ.mənt", "pos": "n.", "zh": "附件", "theme": "辦公室與行政", "example_en": "I forgot to include the attachment.", "example_zh": "我忘了附上附件。", "audio": "audio/office-02-w.m4a", "audio_ms": 797, "example_audio": "audio/office-02-e.m4a", "example_ms": 1877}, {"term": "deadline", "syllables": ["dead", "line"], "stress": 0, "ipa": "ˈdɛdˌlaɪn", "pos": "n.", "zh": "截止期限", "theme": "辦公室與行政", "example_en": "The deadline has been moved to Friday.", "example_zh": "期限已經改到週五。", "audio": "audio/office-03-w.m4a", "audio_ms": 735, "example_audio": "audio/office-03-e.m4a", "example_ms": 1939}, {"term": "memo", "syllables": ["mem", "o"], "stress": 0, "ipa": "ˈmɛˌmoʊ", "pos": "n.", "zh": "內部通知、備忘錄", "theme": "辦公室與行政", "example_en": "A memo was sent to all departments.", "example_zh": "已發通知給所有部門。", "audio": "audio/office-04-w.m4a", "audio_ms": 501, "example_audio": "audio/office-04-e.m4a", "example_ms": 2040}, {"term": "confidential", "syllables": ["con", "fi", "den", "tial"], "stress": 2, "ipa": "ˌkɑn.fəˈdɛn.ʃəl", "pos": "adj.", "zh": "機密的", "theme": "辦公室與行政", "example_en": "This file is strictly confidential.", "example_zh": "這份檔案是機密的。", "audio": "audio/office-05-w.m4a", "audio_ms": 1018, "example_audio": "audio/office-05-e.m4a", "example_ms": 2042}, {"term": "forward", "syllables": ["for", "ward"], "stress": 0, "ipa": "ˈfɔr.wərd", "pos": "v.", "zh": "轉寄", "theme": "辦公室與行政", "example_en": "Could you forward that email to me?", "example_zh": "可以把那封信轉寄給我嗎？", "audio": "audio/office-06-w.m4a", "audio_ms": 684, "example_audio": "audio/office-06-e.m4a", "example_ms": 1740}, {"term": "postpone", "syllables": ["post", "pone"], "stress": 1, "ipa": "poʊstˈpoʊn", "pos": "v.", "zh": "延期", "theme": "辦公室與行政", "example_en": "We had to postpone the launch.", "example_zh": "我們只好把發表會延期。", "audio": "audio/office-07-w.m4a", "audio_ms": 854, "example_audio": "audio/office-07-e.m4a", "example_ms": 1605}, {"term": "draft", "syllables": ["draft"], "stress": 0, "ipa": "ˈdræft", "pos": "n.", "zh": "草稿", "theme": "辦公室與行政", "example_en": "Send me a rough draft by noon.", "example_zh": "中午前給我一份草稿。", "audio": "audio/office-08-w.m4a", "audio_ms": 539, "example_audio": "audio/office-08-e.m4a", "example_ms": 1675}, {"term": "stationery", "syllables": ["sta", "tio", "ne", "ry"], "stress": 0, "ipa": "ˈsteɪ.ʃəˌnɛ.ri", "pos": "n.", "zh": "文具", "theme": "辦公室與行政", "example_en": "We're running low on stationery.", "example_zh": "我們的文具快用完了。", "audio": "audio/office-09-w.m4a", "audio_ms": 952, "example_audio": "audio/office-09-e.m4a", "example_ms": 1732}, {"term": "duplicate", "syllables": ["du", "pli", "cate"], "stress": 0, "ipa": "ˈdu.plə.kət", "pos": "n.", "zh": "副本、複本", "theme": "辦公室與行政", "example_en": "Keep a duplicate for your records.", "example_zh": "留一份副本存檔。", "audio": "audio/office-10-w.m4a", "audio_ms": 827, "example_audio": "audio/office-10-e.m4a", "example_ms": 1856}, {"term": "workload", "syllables": ["work", "load"], "stress": 0, "ipa": "ˈwɜrˌkloʊd", "pos": "n.", "zh": "工作量", "theme": "辦公室與行政", "example_en": "My workload has doubled this month.", "example_zh": "我這個月的工作量翻倍了。", "audio": "audio/office-11-w.m4a", "audio_ms": 650, "example_audio": "audio/office-11-e.m4a", "example_ms": 1932}, {"term": "urgent", "syllables": ["ur", "gent"], "stress": 0, "ipa": "ˈɜr.dʒənt", "pos": "adj.", "zh": "緊急的", "theme": "辦公室與行政", "example_en": "This request is urgent.", "example_zh": "這件事很緊急。", "audio": "audio/office-12-w.m4a", "audio_ms": 491, "example_audio": "audio/office-12-e.m4a", "example_ms": 1310}, {"term": "minutes", "syllables": ["min", "utes"], "stress": 0, "ipa": "ˈmɪ.nəts", "pos": "n.", "zh": "會議記錄", "theme": "會議與簡報", "example_en": "Who is taking the minutes today?", "example_zh": "今天誰做會議記錄？", "audio": "audio/meetings-01-w.m4a", "audio_ms": 536, "example_audio": "audio/meetings-01-e.m4a", "example_ms": 1737}, {"term": "attendee", "syllables": ["at", "ten", "dee"], "stress": 1, "ipa": "əˈtɛnˈdi", "pos": "n.", "zh": "與會者", "theme": "會議與簡報", "example_en": "We expect about thirty attendees.", "example_zh": "預計大約三十位與會者。", "audio": "audio/meetings-02-w.m4a", "audio_ms": 680, "example_audio": "audio/meetings-02-e.m4a", "example_ms": 1964}, {"term": "presentation", "syllables": ["pre", "sen", "ta", "tion"], "stress": 2, "ipa": "ˌprɛ.zənˈteɪ.ʃən", "pos": "n.", "zh": "簡報", "theme": "會議與簡報", "example_en": "Her presentation was very clear.", "example_zh": "她的簡報講得很清楚。", "audio": "audio/meetings-03-w.m4a", "audio_ms": 994, "example_audio": "audio/meetings-03-e.m4a", "example_ms": 1923}, {"term": "handout", "syllables": ["hand", "out"], "stress": 0, "ipa": "ˈhænˌdaʊt", "pos": "n.", "zh": "講義、書面資料", "theme": "會議與簡報", "example_en": "Please take a handout from the table.", "example_zh": "請到桌上拿一份講義。", "audio": "audio/meetings-04-w.m4a", "audio_ms": 656, "example_audio": "audio/meetings-04-e.m4a", "example_ms": 1890}, {"term": "venue", "syllables": ["ve", "nue"], "stress": 0, "ipa": "ˈvɛn.ju", "pos": "n.", "zh": "場地", "theme": "會議與簡報", "example_en": "We need a bigger venue.", "example_zh": "我們需要更大的場地。", "audio": "audio/meetings-05-w.m4a", "audio_ms": 501, "example_audio": "audio/meetings-05-e.m4a", "example_ms": 1175}, {"term": "summarize", "syllables": ["sum", "ma", "rize"], "stress": 0, "ipa": "ˈsʌ.mərˌaɪz", "pos": "v.", "zh": "總結", "theme": "會議與簡報", "example_en": "Could you summarize the main points?", "example_zh": "可以總結一下重點嗎？", "audio": "audio/meetings-06-w.m4a", "audio_ms": 755, "example_audio": "audio/meetings-06-e.m4a", "example_ms": 1809}, {"term": "clarify", "syllables": ["clar", "i", "fy"], "stress": 0, "ipa": "ˈklɛ.rəˌfaɪ", "pos": "v.", "zh": "釐清、說明清楚", "theme": "會議與簡報", "example_en": "Let me clarify what I meant.", "example_zh": "讓我把我的意思講清楚。", "audio": "audio/meetings-07-w.m4a", "audio_ms": 785, "example_audio": "audio/meetings-07-e.m4a", "example_ms": 1746}, {"term": "reschedule", "syllables": ["res", "che", "dule"], "stress": 1, "ipa": "riˈskɛ.dʒul", "pos": "v.", "zh": "改期", "theme": "會議與簡報", "example_en": "Can we reschedule for next week?", "example_zh": "可以改到下週嗎？", "audio": "audio/meetings-08-w.m4a", "audio_ms": 831, "example_audio": "audio/meetings-08-e.m4a", "example_ms": 1927}, {"term": "consensus", "syllables": ["con", "sen", "sus"], "stress": 1, "ipa": "kənˈsɛn.səs", "pos": "n.", "zh": "共識", "theme": "會議與簡報", "example_en": "We reached a consensus quickly.", "example_zh": "我們很快就有共識了。", "audio": "audio/meetings-09-w.m4a", "audio_ms": 925, "example_audio": "audio/meetings-09-e.m4a", "example_ms": 1779}, {"term": "quarterly", "syllables": ["quar", "ter", "ly"], "stress": 0, "ipa": "ˈkwɔr.tər.li", "pos": "adj.", "zh": "每季的", "theme": "會議與簡報", "example_en": "The quarterly report is due tomorrow.", "example_zh": "季報明天到期。", "audio": "audio/meetings-10-w.m4a", "audio_ms": 657, "example_audio": "audio/meetings-10-e.m4a", "example_ms": 1928}, {"term": "brief", "syllables": ["brief"], "stress": 0, "ipa": "ˈbrif", "pos": "v.", "zh": "簡短說明狀況", "theme": "會議與簡報", "example_en": "I'll brief the team this afternoon.", "example_zh": "我下午跟團隊說明狀況。", "audio": "audio/meetings-11-w.m4a", "audio_ms": 507, "example_audio": "audio/meetings-11-e.m4a", "example_ms": 1691}, {"term": "objective", "syllables": ["ob", "jec", "tive"], "stress": 1, "ipa": "əbˈdʒɛk.tɪv", "pos": "n.", "zh": "目標", "theme": "會議與簡報", "example_en": "Our main objective is cost control.", "example_zh": "我們的主要目標是控制成本。", "audio": "audio/meetings-12-w.m4a", "audio_ms": 738, "example_audio": "audio/meetings-12-e.m4a", "example_ms": 1993}, {"term": "applicant", "syllables": ["ap", "pli", "cant"], "stress": 0, "ipa": "ˈæ.plɪ.kənt", "pos": "n.", "zh": "應徵者", "theme": "人事與招募", "example_en": "We received over two hundred applicants.", "example_zh": "我們收到兩百多位應徵者。", "audio": "audio/hr-01-w.m4a", "audio_ms": 703, "example_audio": "audio/hr-01-e.m4a", "example_ms": 2243}, {"term": "resume", "syllables": ["re", "sume"], "stress": 1, "ipa": "rɪˈzum", "pos": "n.", "zh": "履歷", "theme": "人事與招募", "example_en": "Attach your resume to the email.", "example_zh": "把履歷附在信裡。", "audio": "audio/hr-02-w.m4a", "audio_ms": 599, "example_audio": "audio/hr-02-e.m4a", "example_ms": 1866}, {"term": "candidate", "syllables": ["can", "di", "date"], "stress": 0, "ipa": "ˈkæn.də.deɪt", "pos": "n.", "zh": "人選、候選人", "theme": "人事與招募", "example_en": "She is the strongest candidate.", "example_zh": "她是最強的人選。", "audio": "audio/hr-03-w.m4a", "audio_ms": 704, "example_audio": "audio/hr-03-e.m4a", "example_ms": 1740}, {"term": "supervisor", "syllables": ["su", "per", "vi", "sor"], "stress": 0, "ipa": "ˈsu.pərˌvaɪ.zər", "pos": "n.", "zh": "主管", "theme": "人事與招募", "example_en": "Ask your supervisor to approve it.", "example_zh": "請你主管核准。", "audio": "audio/hr-04-w.m4a", "audio_ms": 987, "example_audio": "audio/hr-04-e.m4a", "example_ms": 1924}, {"term": "promotion", "syllables": ["pro", "mo", "tion"], "stress": 1, "ipa": "prəˈmoʊ.ʃən", "pos": "n.", "zh": "升遷", "theme": "人事與招募", "example_en": "He got a promotion last month.", "example_zh": "他上個月升職了。", "audio": "audio/hr-05-w.m4a", "audio_ms": 738, "example_audio": "audio/hr-05-e.m4a", "example_ms": 1819}, {"term": "benefits", "syllables": ["ben", "e", "fits"], "stress": 0, "ipa": "ˈbɛ.nə.fɪts", "pos": "n.", "zh": "福利", "theme": "人事與招募", "example_en": "The benefits include health insurance.", "example_zh": "福利包含健康保險。", "audio": "audio/hr-06-w.m4a", "audio_ms": 767, "example_audio": "audio/hr-06-e.m4a", "example_ms": 2055}, {"term": "payroll", "syllables": ["pay", "roll"], "stress": 0, "ipa": "ˈpeɪˌroʊl", "pos": "n.", "zh": "薪資（名冊）", "theme": "人事與招募", "example_en": "Payroll is processed on the fifth.", "example_zh": "薪資在五號處理。", "audio": "audio/hr-07-w.m4a", "audio_ms": 657, "example_audio": "audio/hr-07-e.m4a", "example_ms": 1843}, {"term": "probation", "syllables": ["pro", "ba", "tion"], "stress": 1, "ipa": "proʊˈbeɪ.ʃən", "pos": "n.", "zh": "試用期", "theme": "人事與招募", "example_en": "New hires have a three-month probation.", "example_zh": "新進人員有三個月試用期。", "audio": "audio/hr-08-w.m4a", "audio_ms": 773, "example_audio": "audio/hr-08-e.m4a", "example_ms": 2108}, {"term": "recruit", "syllables": ["re", "cruit"], "stress": 1, "ipa": "rəˈkrut", "pos": "v.", "zh": "招募", "theme": "人事與招募", "example_en": "We plan to recruit five engineers.", "example_zh": "我們打算招五名工程師。", "audio": "audio/hr-09-w.m4a", "audio_ms": 680, "example_audio": "audio/hr-09-e.m4a", "example_ms": 2034}, {"term": "qualification", "syllables": ["qual", "i", "fi", "ca", "tion"], "stress": 3, "ipa": "ˌkwɑ.lə.fəˈkeɪ.ʃən", "pos": "n.", "zh": "資格條件", "theme": "人事與招募", "example_en": "He meets every qualification.", "example_zh": "他符合所有條件。", "audio": "audio/hr-10-w.m4a", "audio_ms": 1168, "example_audio": "audio/hr-10-e.m4a", "example_ms": 1772}, {"term": "resign", "syllables": ["re", "sign"], "stress": 1, "ipa": "rɪˈzaɪn", "pos": "v.", "zh": "辭職", "theme": "人事與招募", "example_en": "She resigned without notice.", "example_zh": "她沒預告就辭職了。", "audio": "audio/hr-11-w.m4a", "audio_ms": 668, "example_audio": "audio/hr-11-e.m4a", "example_ms": 1566}, {"term": "overtime", "syllables": ["o", "ver", "time"], "stress": 0, "ipa": "ˈoʊ.vərˌtaɪm", "pos": "n.", "zh": "加班", "theme": "人事與招募", "example_en": "We're not paid for overtime.", "example_zh": "我們加班沒有加班費。", "audio": "audio/hr-12-w.m4a", "audio_ms": 897, "example_audio": "audio/hr-12-e.m4a", "example_ms": 1697}, {"term": "invoice", "syllables": ["in", "voice"], "stress": 0, "ipa": "ˈɪn.vɔɪs", "pos": "n.", "zh": "請款單、發票", "theme": "財務與帳務", "example_en": "Please send the invoice by Friday.", "example_zh": "請在週五前寄出請款單。", "audio": "audio/finance-01-w.m4a", "audio_ms": 658, "example_audio": "audio/finance-01-e.m4a", "example_ms": 1856}, {"term": "receipt", "syllables": ["re", "ceipt"], "stress": 1, "ipa": "rɪˈsit", "pos": "n.", "zh": "收據", "theme": "財務與帳務", "example_en": "Keep the receipt for reimbursement.", "example_zh": "收據留著報帳用。", "audio": "audio/finance-02-w.m4a", "audio_ms": 634, "example_audio": "audio/finance-02-e.m4a", "example_ms": 1774}, {"term": "expense", "syllables": ["ex", "pense"], "stress": 1, "ipa": "ɪkˈspɛns", "pos": "n.", "zh": "費用、支出", "theme": "財務與帳務", "example_en": "Travel expenses are covered.", "example_zh": "差旅費用公司負擔。", "audio": "audio/finance-03-w.m4a", "audio_ms": 819, "example_audio": "audio/finance-03-e.m4a", "example_ms": 1649}, {"term": "budget", "syllables": ["bud", "get"], "stress": 0, "ipa": "ˈbʌ.dʒɪt", "pos": "n.", "zh": "預算", "theme": "財務與帳務", "example_en": "That's outside our budget.", "example_zh": "那超出我們的預算。", "audio": "audio/finance-04-w.m4a", "audio_ms": 489, "example_audio": "audio/finance-04-e.m4a", "example_ms": 1334}, {"term": "reimbursement", "syllables": ["re", "im", "burse", "ment"], "stress": 2, "ipa": "ˌri.ɪmˈbɜr.smənt", "pos": "n.", "zh": "報帳、核銷", "theme": "財務與帳務", "example_en": "Reimbursement takes about two weeks.", "example_zh": "核銷大約要兩週。", "audio": "audio/finance-05-w.m4a", "audio_ms": 912, "example_audio": "audio/finance-05-e.m4a", "example_ms": 2144}, {"term": "revenue", "syllables": ["re", "ve", "nue"], "stress": 0, "ipa": "ˈrɛ.vəˌnu", "pos": "n.", "zh": "營收", "theme": "財務與帳務", "example_en": "Revenue grew by twelve percent.", "example_zh": "營收成長了百分之十二。", "audio": "audio/finance-06-w.m4a", "audio_ms": 620, "example_audio": "audio/finance-06-e.m4a", "example_ms": 1783}, {"term": "deposit", "syllables": ["de", "po", "sit"], "stress": 1, "ipa": "dəˈpɑ.zɪt", "pos": "n.", "zh": "訂金、押金", "theme": "財務與帳務", "example_en": "A deposit is required in advance.", "example_zh": "需要先付訂金。", "audio": "audio/finance-07-w.m4a", "audio_ms": 700, "example_audio": "audio/finance-07-e.m4a", "example_ms": 2075}, {"term": "refund", "syllables": ["re", "fund"], "stress": 1, "ipa": "rɪˈfʌnd", "pos": "n.", "zh": "退款", "theme": "財務與帳務", "example_en": "You can request a full refund.", "example_zh": "你可以申請全額退款。", "audio": "audio/finance-08-w.m4a", "audio_ms": 668, "example_audio": "audio/finance-08-e.m4a", "example_ms": 1734}, {"term": "installment", "syllables": ["in", "stall", "ment"], "stress": 1, "ipa": "ˌɪnˈstɔl.mənt", "pos": "n.", "zh": "分期付款", "theme": "財務與帳務", "example_en": "We pay in three installments.", "example_zh": "我們分三期付款。", "audio": "audio/finance-09-w.m4a", "audio_ms": 797, "example_audio": "audio/finance-09-e.m4a", "example_ms": 1616}, {"term": "audit", "syllables": ["au", "dit"], "stress": 0, "ipa": "ˈɔ.dɪt", "pos": "n.", "zh": "稽核", "theme": "財務與帳務", "example_en": "The annual audit starts Monday.", "example_zh": "年度稽核週一開始。", "audio": "audio/finance-10-w.m4a", "audio_ms": 443, "example_audio": "audio/finance-10-e.m4a", "example_ms": 1775}, {"term": "overdue", "syllables": ["o", "ver", "due"], "stress": 0, "ipa": "ˈoʊ.vərˈdu", "pos": "adj.", "zh": "逾期的", "theme": "財務與帳務", "example_en": "Your payment is two weeks overdue.", "example_zh": "你的款項逾期兩週了。", "audio": "audio/finance-11-w.m4a", "audio_ms": 700, "example_audio": "audio/finance-11-e.m4a", "example_ms": 1920}, {"term": "discount", "syllables": ["dis", "count"], "stress": 1, "ipa": "dɪˈskaʊnt", "pos": "n.", "zh": "折扣", "theme": "財務與帳務", "example_en": "They offered a ten percent discount.", "example_zh": "他們給了九折。", "audio": "audio/finance-12-w.m4a", "audio_ms": 677, "example_audio": "audio/finance-12-e.m4a", "example_ms": 1879}, {"term": "supplier", "syllables": ["sup", "pli", "er"], "stress": 1, "ipa": "səˈplaɪ.ər", "pos": "n.", "zh": "供應商", "theme": "採購與合約", "example_en": "We switched to a cheaper supplier.", "example_zh": "我們換了比較便宜的供應商。", "audio": "audio/purchasing-01-w.m4a", "audio_ms": 825, "example_audio": "audio/purchasing-01-e.m4a", "example_ms": 1883}, {"term": "quotation", "syllables": ["quo", "ta", "tion"], "stress": 1, "ipa": "kwoʊˈteɪ.ʃən", "pos": "n.", "zh": "報價單", "theme": "採購與合約", "example_en": "Could you send us a quotation?", "example_zh": "可以給我們一份報價嗎？", "audio": "audio/purchasing-02-w.m4a", "audio_ms": 866, "example_audio": "audio/purchasing-02-e.m4a", "example_ms": 1635}, {"term": "negotiate", "syllables": ["ne", "go", "ti", "ate"], "stress": 1, "ipa": "nəˈɡoʊ.ʃiˌeɪt", "pos": "v.", "zh": "談判、議價", "theme": "採購與合約", "example_en": "We managed to negotiate a better price.", "example_zh": "我們談到了更好的價格。", "audio": "audio/purchasing-03-w.m4a", "audio_ms": 899, "example_audio": "audio/purchasing-03-e.m4a", "example_ms": 2336}, {"term": "contract", "syllables": ["con", "tract"], "stress": 0, "ipa": "ˈkɑnˌtrækt", "pos": "n.", "zh": "合約", "theme": "採購與合約", "example_en": "The contract expires in June.", "example_zh": "合約六月到期。", "audio": "audio/purchasing-04-w.m4a", "audio_ms": 751, "example_audio": "audio/purchasing-04-e.m4a", "example_ms": 1788}, {"term": "renew", "syllables": ["re", "new"], "stress": 1, "ipa": "rɪˈnu", "pos": "v.", "zh": "續約、更新", "theme": "採購與合約", "example_en": "We decided not to renew the contract.", "example_zh": "我們決定不續約。", "audio": "audio/purchasing-05-w.m4a", "audio_ms": 564, "example_audio": "audio/purchasing-05-e.m4a", "example_ms": 2197}, {"term": "warranty", "syllables": ["war", "ran", "ty"], "stress": 0, "ipa": "ˈwɔ.rən.ti", "pos": "n.", "zh": "保固", "theme": "採購與合約", "example_en": "The warranty covers two years.", "example_zh": "保固期兩年。", "audio": "audio/purchasing-06-w.m4a", "audio_ms": 732, "example_audio": "audio/purchasing-06-e.m4a", "example_ms": 1707}, {"term": "vendor", "syllables": ["ven", "dor"], "stress": 0, "ipa": "ˈvɛn.dər", "pos": "n.", "zh": "廠商", "theme": "採購與合約", "example_en": "Three vendors submitted bids.", "example_zh": "三家廠商投標。", "audio": "audio/purchasing-07-w.m4a", "audio_ms": 490, "example_audio": "audio/purchasing-07-e.m4a", "example_ms": 1604}, {"term": "specification", "syllables": ["spec", "i", "fi", "ca", "tion"], "stress": 3, "ipa": "ˌspɛ.sɪ.fɪˈkeɪ.ʃən", "pos": "n.", "zh": "規格", "theme": "採購與合約", "example_en": "The part must match the specification.", "example_zh": "零件必須符合規格。", "audio": "audio/purchasing-08-w.m4a", "audio_ms": 1231, "example_audio": "audio/purchasing-08-e.m4a", "example_ms": 2195}, {"term": "approve", "syllables": ["ap", "prove"], "stress": 1, "ipa": "əˈpruv", "pos": "v.", "zh": "核准", "theme": "採購與合約", "example_en": "The manager has to approve the order.", "example_zh": "訂單要經理核准。", "audio": "audio/purchasing-09-w.m4a", "audio_ms": 599, "example_audio": "audio/purchasing-09-e.m4a", "example_ms": 1858}, {"term": "bid", "syllables": ["bid"], "stress": 0, "ipa": "ˈbɪd", "pos": "n.", "zh": "投標、報價", "theme": "採購與合約", "example_en": "Their bid was the lowest.", "example_zh": "他們的報價最低。", "audio": "audio/purchasing-10-w.m4a", "audio_ms": 379, "example_audio": "audio/purchasing-10-e.m4a", "example_ms": 1136}, {"term": "clause", "syllables": ["clause"], "stress": 0, "ipa": "ˈklɔz", "pos": "n.", "zh": "條款", "theme": "採購與合約", "example_en": "Read the cancellation clause carefully.", "example_zh": "仔細看取消條款。", "audio": "audio/purchasing-11-w.m4a", "audio_ms": 569, "example_audio": "audio/purchasing-11-e.m4a", "example_ms": 2062}, {"term": "compliance", "syllables": ["com", "pli", "ance"], "stress": 1, "ipa": "kəmˈplaɪ.əns", "pos": "n.", "zh": "合規、遵守規定", "theme": "採購與合約", "example_en": "Compliance is checked every quarter.", "example_zh": "合規每季查核一次。", "audio": "audio/purchasing-12-w.m4a", "audio_ms": 878, "example_audio": "audio/purchasing-12-e.m4a", "example_ms": 1834}, {"term": "inventory", "syllables": ["in", "ven", "to", "ry"], "stress": 2, "ipa": "ˌɪn.vənˈtɔ.ri", "pos": "n.", "zh": "庫存", "theme": "物流與庫存", "example_en": "We take inventory every month.", "example_zh": "我們每個月盤點庫存。", "audio": "audio/logistics-01-w.m4a", "audio_ms": 739, "example_audio": "audio/logistics-01-e.m4a", "example_ms": 1767}, {"term": "warehouse", "syllables": ["ware", "house"], "stress": 0, "ipa": "ˈwɛrˌhaʊs", "pos": "n.", "zh": "倉庫", "theme": "物流與庫存", "example_en": "The goods are still in the warehouse.", "example_zh": "貨還在倉庫裡。", "audio": "audio/logistics-02-w.m4a", "audio_ms": 778, "example_audio": "audio/logistics-02-e.m4a", "example_ms": 1626}, {"term": "shipment", "syllables": ["ship", "ment"], "stress": 0, "ipa": "ˈʃɪp.mənt", "pos": "n.", "zh": "出貨、一批貨", "theme": "物流與庫存", "example_en": "The shipment arrives on Thursday.", "example_zh": "貨週四到。", "audio": "audio/logistics-03-w.m4a", "audio_ms": 634, "example_audio": "audio/logistics-03-e.m4a", "example_ms": 1707}, {"term": "freight", "syllables": ["freight"], "stress": 0, "ipa": "ˈfreɪt", "pos": "n.", "zh": "貨運、運費", "theme": "物流與庫存", "example_en": "Freight costs went up again.", "example_zh": "運費又漲了。", "audio": "audio/logistics-04-w.m4a", "audio_ms": 522, "example_audio": "audio/logistics-04-e.m4a", "example_ms": 1499}, {"term": "defective", "syllables": ["de", "fec", "tive"], "stress": 1, "ipa": "dɪˈfɛk.tɪv", "pos": "adj.", "zh": "有瑕疵的", "theme": "物流與庫存", "example_en": "Two units were defective.", "example_zh": "有兩台是瑕疵品。", "audio": "audio/logistics-05-w.m4a", "audio_ms": 734, "example_audio": "audio/logistics-05-e.m4a", "example_ms": 1416}, {"term": "packaging", "syllables": ["pack", "ag", "ing"], "stress": 0, "ipa": "ˈpæ.kɪ.dʒɪŋ", "pos": "n.", "zh": "包裝", "theme": "物流與庫存", "example_en": "The packaging was damaged.", "example_zh": "包裝破損了。", "audio": "audio/logistics-06-w.m4a", "audio_ms": 739, "example_audio": "audio/logistics-06-e.m4a", "example_ms": 1475}, {"term": "restock", "syllables": ["re", "stock"], "stress": 1, "ipa": "riˈstɑk", "pos": "v.", "zh": "補貨", "theme": "物流與庫存", "example_en": "We restock every Monday.", "example_zh": "我們每週一補貨。", "audio": "audio/logistics-07-w.m4a", "audio_ms": 692, "example_audio": "audio/logistics-07-e.m4a", "example_ms": 1396}, {"term": "courier", "syllables": ["couri", "er"], "stress": null, "ipa": "ˈkɜr.i.ər", "pos": "n.", "zh": "快遞", "theme": "物流與庫存", "example_en": "Send it by courier, please.", "example_zh": "麻煩用快遞寄。", "audio": "audio/logistics-08-w.m4a", "audio_ms": 564, "example_audio": "audio/logistics-08-e.m4a", "example_ms": 1837}, {"term": "customs", "syllables": ["cus", "toms"], "stress": 0, "ipa": "ˈkʌ.stəmz", "pos": "n.", "zh": "海關", "theme": "物流與庫存", "example_en": "The package is held at customs.", "example_zh": "包裹卡在海關。", "audio": "audio/logistics-09-w.m4a", "audio_ms": 704, "example_audio": "audio/logistics-09-e.m4a", "example_ms": 1742}, {"term": "delay", "syllables": ["de", "lay"], "stress": 1, "ipa": "dɪˈleɪ", "pos": "n.", "zh": "延誤", "theme": "物流與庫存", "example_en": "There's a two-day delay.", "example_zh": "有兩天的延誤。", "audio": "audio/logistics-10-w.m4a", "audio_ms": 538, "example_audio": "audio/logistics-10-e.m4a", "example_ms": 1287}, {"term": "distributor", "syllables": ["dis", "trib", "u", "tor"], "stress": 1, "ipa": "dɪˈstrɪ.bjə.tər", "pos": "n.", "zh": "經銷商", "theme": "物流與庫存", "example_en": "They are our distributor in Japan.", "example_zh": "他們是我們在日本的經銷商。", "audio": "audio/logistics-11-w.m4a", "audio_ms": 804, "example_audio": "audio/logistics-11-e.m4a", "example_ms": 1821}, {"term": "logistics", "syllables": ["lo", "gis", "tics"], "stress": 1, "ipa": "ləˈdʒɪ.stɪks", "pos": "n.", "zh": "物流", "theme": "物流與庫存", "example_en": "Logistics is handled by a third party.", "example_zh": "物流交給第三方處理。", "audio": "audio/logistics-12-w.m4a", "audio_ms": 989, "example_audio": "audio/logistics-12-e.m4a", "example_ms": 2292}, {"term": "itinerary", "syllables": ["i", "ti", "ne", "ra", "ry"], "stress": 1, "ipa": "aɪˈtɪ.nərˌɛ.ri", "pos": "n.", "zh": "行程表", "theme": "差旅與交通", "example_en": "I'll email you the itinerary.", "example_zh": "我把行程表寄給你。", "audio": "audio/travel-01-w.m4a", "audio_ms": 877, "example_audio": "audio/travel-01-e.m4a", "example_ms": 1726}, {"term": "reservation", "syllables": ["re", "ser", "va", "tion"], "stress": 2, "ipa": "ˌrɛ.zərˈveɪ.ʃən", "pos": "n.", "zh": "訂位、預約", "theme": "差旅與交通",